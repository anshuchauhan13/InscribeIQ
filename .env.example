# EmailJS configuration — copy this file to ".env.local" and fill in your values.
# Find these in your EmailJS dashboard (emailjs.com):
#   Service ID  → Email Services
#   Template IDs → Email Templates (one for the admin notice, one for the thank-you)
#   Public Key  → Account → General
#
# NOTE: The public key ships in the browser bundle by design. Lock it down in
# EmailJS → Account → Security by allow-listing your domain.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_TEMPLATE_ADMIN=your_admin_template_id
VITE_EMAILJS_TEMPLATE_THANKYOU=your_thankyou_template_id

# Inbox that receives the lead notifications. In the ADMIN template on EmailJS,
# set the "To Email" field to {{to_email}} for this to take effect.
VITE_EMAILJS_ADMIN_EMAIL=leads@yourdomain.com
